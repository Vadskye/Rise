    {
      "name": "Giants",
      "folder": "Uncivilized Humanoids",
      "hasArt": false,
      "sharedFreeformCode": "",
      "monsters": [
        {
          "name": "Hill giant",
          "requiredProperties": {
            "alignment": "chaotic neutral",
            "base_class": "brute",
            "elite": false,
            "creature_origin": "natural",
            "creature_types": [
              "humanoid"
            ],
            "size": "huge",
            "level": 10
          },
          "freeformCode": "",
          "standardAbilities": [],
          "knowledge": {
            "normal": "A hill giant is a Huge giant that is usually found in hilly areas. Hill giants prefer to fight from high, rocky outcroppings, where they can pelt opponents with rocks and boulders while limiting the risk to themselves. Skin color among hill giants ranges from light tan to deep ruddy brown. They wear layers of crudely prepared hides with the fur left on.",
            "hard": "Hill giants lack the intelligence or desire to retreat if their enemies survive to approach them, and prefer to draw their massive clubs and enter melee. If possible, they smash their foes off of cliffs.\n\nThe hair of hill giants is brown or black, with eyes the same color. They seldom wash or repair their garments, preferring to simply add more hides as their old ones wear out. Adult hill giants are about 25 feet tall. They can live to be 70 years old."
          },
          "baseAttributes": [
            8,
            0,
            3,
            -2,
            2,
            -1
          ]
        }
      ],
      "knowledge": {
        "easy": "Giants are massive humanoid creatures that tower over lesser creatures. All giants have immense strength and unimpressive agility.",
        "normal": "Giants are skilled at throwing boulders, either to hunt or to protect themselves.",
        "hard": ""
      },
      "passiveAbilities": [
        {
          "name": "Boulder Thrower",
          "effect": "Giants can throw objects no larger than two size categories smaller than themselves with ease. Their descriptions list their statistics when throwing boulders. A giant's \\glossterm{range limits} with an improvised object other than a boulder are generally half its range limit with a boulder. The object may also deal less damage than a boulder depending on its construction.",
          "isMagical": false
        }
      ]
    }
