{
  "extends": "../tsconfig.json",
  "jsx": "react-jsx",
  "compilerOptions": {
    "rootDir": "..",
    "module": "esnext",
    "moduleResolution": "node",
    "target": "ES2021",
    "baseUrl": "..",
